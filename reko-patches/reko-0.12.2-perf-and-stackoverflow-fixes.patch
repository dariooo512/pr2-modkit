+        // --- PERF (added) ---------------------------------------------------
+        // On whole-program runs, unification yields one giant, deeply-nested
+        // merged type graph. Choose() is called per union-typed expression and
+        // re-walks that graph each time (deep recursion + a huge visitedTypes
+        // set), which dominates codegen and effectively hangs.
+        //
+        // MaxTypesPerQuery bounds how many distinct types one query may explore;
+        // beyond it the query gives up (returns null = "no alternative", a result
+        // the callers already handle), so a degenerate graph can't stall the run.
+        // The memo caches results: during the rewrite phase the type graph is
+        // immutable, so Choose is a pure function of its arguments.
+        private const int MaxTypesPerQuery = 4000;
+        private static readonly System.Collections.Concurrent.ConcurrentDictionary<ChooseKey, UnionAlternative?> memo =
+            new(new ChooseKeyComparer());
+        private static long nCalls, nHits, nCapped;
+
+        private readonly struct ChooseKey
+        {
+            public readonly DataType Ut; public readonly DataType? Dt;
+            public readonly bool Ptr; public readonly int Off;
+            public ChooseKey(DataType ut, DataType? dt, bool ptr, int off)
+            { Ut = ut; Dt = dt; Ptr = ptr; Off = off; }
+        }
+        private sealed class ChooseKeyComparer : IEqualityComparer<ChooseKey>
+        {
+            public bool Equals(ChooseKey a, ChooseKey b) =>
+                ReferenceEquals(a.Ut, b.Ut) && ReferenceEquals(a.Dt, b.Dt) &&
+                a.Ptr == b.Ptr && a.Off == b.Off;
+            public int GetHashCode(ChooseKey k)
+            {
+                int h = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(k.Ut);
+                if (k.Dt is not null)
+                    h = h * 31 + System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(k.Dt);
+                return (h * 31 + (k.Ptr ? 1 : 0)) * 31 + k.Off;
+            }
+        }
+
