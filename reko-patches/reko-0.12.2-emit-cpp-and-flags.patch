+#region License
+/*
+ * [PR2] Analysis checkpoint for fast header AND body iteration.
+ *
+ * ReconstructTypes (whole-program type inference) is ~95% of the decode wall-clock and is
+ * identical on every run when only the EMITTER changes. This caches the post-analysis state
+ * (the EquivalenceClass -> DataType type graph PLUS the structured procedures) to disk, so a
+ * subsequent run can SKIP scan/dataflow/type-inference/structuring and re-emit program.h +
+ * program.c directly -- seconds instead of ~30 min.
+ *
+ * Roots (in order; see Decompiler.SaveTypeCache / LoadTypeCache):
+ *   [0] List<EquivalenceClass>  -- the used type graph (enough on its own for program.h)
+ *   [1] List<Procedure>         -- post-StructureProgram procedures (Body built) for program.c
+ *   [2] Dictionary<string,string[]> -- per-proc caller names (the "// Called from:" comments,
+ *                                      so we don't have to serialize the whole CallGraph)
+ * They share ONE id table, so a type referenced by both a type-graph root and a procedure
+ * round-trips as the SAME instance. A header-only load reads only root [0] (cheap).
+ *
+ * The serializer is a small reflection-based binary graph writer: primitives, strings, enums,
+ * List<>/HashSet<>, IDictionary and general objects (by field), with object identity preserved
+ * via an id table (cyclic graphs round-trip). Objects are rebuilt with
+ * RuntimeHelpers.GetUninitializedObject (no ctor needed).
+ *
+ * Architecture entanglement is handled by CUTTING the arch-bound / redundant subgraphs at
+ * serialization time (they are not needed to re-emit a structured body): values that are an
+ * IProcessorArchitecture / IPlatform / IServiceProvider / IEventListener / Frame / Block /
+ * BlockGraph are written as null. The structured AST (Reko.Core.Absyn.*) never references a
+ * Block, so cutting the pre-structure CFG is safe. Operators are singletons (Operator.IAdd,
+ * ...) whose OperatorType is a ctor-set readonly property, so they are written by their
+ * OperatorType enum and resolved back to the canonical singleton on load (a reflection-cloned
+ * Operator would have a zeroed .Type).
+ */
+#endregion
+
+using Reko.Core;
+using Reko.Core.Absyn;
+using Reko.Core.Expressions;
+using Reko.Core.Graphs;
+using Reko.Core.Operators;
+using Reko.Core.Services;
+using Reko.Core.Types;
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Text;
+
+namespace Reko
+{
+    /// <summary>
+    /// [PR2] Disk checkpoint of the analyzed type store + structured procedures, to skip
+    /// type inference (and structuring) on emitter-only re-runs. See file header.
+    /// </summary>
+    public static class ProgramTypeCache
+    {
+        private const int Magic = 0x504B5432; // "PKT2" (bumped: format now carries procedures)
+
+        /// <summary>Serialize the given <paramref name="roots"/> to <paramref name="path"/>.</summary>
+        public static void Save(IList<object> roots, string path)
+        {
+            using var fs = File.Create(path);
+            using var bw = new BinaryWriter(fs);
+            bw.Write(Magic);
+            var w = new Writer(bw);
+            bw.Write(roots.Count);
+            foreach (var r in roots)
+                w.WriteValue(r, typeof(object));
+        }
+
+        /// <summary>
+        /// Deserialize up to <paramref name="maxRoots"/> roots written by <see cref="Save"/>.
+        /// A header-only load passes maxRoots=1 to read just the type graph (root 0) and stop,
+        /// without paying to deserialize the ~7000 procedures.
+        /// </summary>
+        public static List<object?> Load(string path, int maxRoots = int.MaxValue)
+        {
+            using var fs = File.OpenRead(path);
+            using var br = new BinaryReader(fs);
+            if (br.ReadInt32() != Magic)
+                throw new InvalidDataException("Not a PR2 type cache file (or stale format).");
+            var r = new Reader(br);
+            int n = br.ReadInt32();
+            int toRead = Math.Min(n, maxRoots);
+            var roots = new List<object?>(toRead);
+            for (int i = 0; i < toRead; ++i)
+                roots.Add(r.ReadValue(typeof(object)));
+            // Populate hashed/compared collections only now that every object's fields are set
+            // (cyclic keys would otherwise be compared/hashed mid-reconstruction; the real type
+            // graph has cyclic types used as SortedList keys in UnionType.Alternatives).
+            r.RunDeferred();
+            return roots;
+        }
+
+        // Tags
+        private const byte T_NULL = 0, T_REF = 1, T_PRIM = 2, T_STRING = 3, T_ENUM = 4,
+                           T_ARRAY = 5, T_DICT = 6, T_LIST = 7, T_OBJECT = 8, T_OPERATOR = 9;
+
+        // Values whose runtime type is one of these are arch-bound or are the redundant
+        // pre-structure CFG; they are not needed to re-emit a structured body, so they are
+        // written as null. (See file header.)
+        private static bool IsCutoff(object o) =>
+            o is IProcessorArchitecture ||
+            o is IPlatform ||
+            o is IServiceProvider ||
+            o is IEventListener ||
+            o is Frame ||
+            o is Block ||
+            o is BlockGraph;
+
+        private static FieldInfo[] InstanceFields(Type t)
+        {
+            var fields = new List<FieldInfo>();
+            for (var ty = t; ty is not null && ty != typeof(object); ty = ty.BaseType)
+            {
+                fields.AddRange(ty.GetFields(
+                    BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic |
+                    BindingFlags.DeclaredOnly));
+            }
+            // Deterministic order independent of reflection quirks; skip compiler/event plumbing.
+            return fields
+                .Where(f => !typeof(Delegate).IsAssignableFrom(f.FieldType))
+                .OrderBy(f => f.DeclaringType!.FullName + "::" + f.Name, StringComparer.Ordinal)
+                .ToArray();
+        }
+
+        // Only ACTUAL List<>/HashSet<> get the by-Add list treatment. Custom collections
+        // (e.g. StructureFieldCollection, which has overloaded Add methods that make
+        // GetMethod("Add") ambiguous) fall through to field-based (T_OBJECT) serialization,
+        // which round-trips their inner List<> naturally.
+        private static bool IsGenericListOrSet(Type t)
+        {
+            if (!t.IsGenericType)
+                return false;
+            var def = t.GetGenericTypeDefinition();
+            return def == typeof(List<>) || def == typeof(HashSet<>);
+        }
+
+        private sealed class Writer
+        {
+            private readonly BinaryWriter bw;
+            private readonly Dictionary<object, int> ids = new(ReferenceEqualityComparer.Instance);
+            public Writer(BinaryWriter bw) { this.bw = bw; }
+
+            public void WriteValue(object? o, Type declared)
+            {
+                if (o is null) { bw.Write(T_NULL); return; }
+                var t = o.GetType();
+                if (t.IsPrimitive) { bw.Write(T_PRIM); bw.Write(t.AssemblyQualifiedName!); WritePrim(o, t); return; }
+                if (o is string s) { bw.Write(T_STRING); bw.Write(s); return; }
+                if (t.IsEnum) { bw.Write(T_ENUM); bw.Write(t.AssemblyQualifiedName!); WritePrim(Convert.ChangeType(o, Enum.GetUnderlyingType(t)), Enum.GetUnderlyingType(t)); return; }
+
+                // Operators are singletons; persist by OperatorType, resolve on load.
+                if (o is Operator op) { bw.Write(T_OPERATOR); bw.Write((int) op.Type); return; }
+
+                // Arch-bound / redundant-CFG values are cut to null (see IsCutoff).
+                if (IsCutoff(o)) { bw.Write(T_NULL); return; }
+
+                // reference types: dedup via id table
+                if (ids.TryGetValue(o, out int id)) { bw.Write(T_REF); bw.Write(id); return; }
+                int newId = ids.Count; ids[o] = newId;
+
+                if (t.IsArray)
+                {
+                    bw.Write(T_ARRAY); bw.Write(newId);
+                    var et = t.GetElementType()!;
+                    bw.Write(t.AssemblyQualifiedName!);
+                    var arr = (Array)o;
+                    bw.Write(arr.Length);
+                    foreach (var e in arr) WriteValue(e, et);
+                    return;
+                }
+                if (o is IDictionary dict)
+                {
+                    bw.Write(T_DICT); bw.Write(newId); bw.Write(t.AssemblyQualifiedName!);
+                    bw.Write(dict.Count);
+                    foreach (DictionaryEntry e in dict) { WriteValue(e.Key, typeof(object)); WriteValue(e.Value, typeof(object)); }
+                    return;
+                }
+                if (IsGenericListOrSet(t))
+                {
+                    bw.Write(T_LIST); bw.Write(newId); bw.Write(t.AssemblyQualifiedName!);
+                    var items = ((IEnumerable)o).Cast<object?>().ToList();
+                    bw.Write(items.Count);
+                    foreach (var e in items) WriteValue(e, typeof(object));
+                    return;
+                }
+                // general object: write each instance field
+                bw.Write(T_OBJECT); bw.Write(newId); bw.Write(t.AssemblyQualifiedName!);
+                var fields = InstanceFields(t);
+                bw.Write(fields.Length);
+                foreach (var f in fields)
+                {
+                    bw.Write(f.DeclaringType!.FullName + "::" + f.Name);
+                    WriteValue(f.GetValue(o), f.FieldType);
+                }
+            }
+
+            private void WritePrim(object o, Type t)
+            {
+                switch (Type.GetTypeCode(t))
+                {
+                case TypeCode.Boolean: bw.Write((bool)o); break;
+                case TypeCode.Byte: bw.Write((byte)o); break;
+                case TypeCode.SByte: bw.Write((sbyte)o); break;
+                case TypeCode.Int16: bw.Write((short)o); break;
+                case TypeCode.UInt16: bw.Write((ushort)o); break;
+                case TypeCode.Int32: bw.Write((int)o); break;
+                case TypeCode.UInt32: bw.Write((uint)o); break;
+                case TypeCode.Int64: bw.Write((long)o); break;
+                case TypeCode.UInt64: bw.Write((ulong)o); break;
+                case TypeCode.Char: bw.Write((char)o); break;
+                case TypeCode.Single: bw.Write((float)o); break;
+                case TypeCode.Double: bw.Write((double)o); break;
+                default:
+                    if (o is IntPtr ip) { bw.Write((long)ip); break; }
+                    if (o is UIntPtr up) { bw.Write((ulong)up); break; }
+                    throw new NotSupportedException("prim " + t);
+                }
+            }
+        }
+
+        private sealed class Reader
+        {
+            private readonly BinaryReader br;
+            private readonly Dictionary<int, object> ids = new();
+            // Inserts into hashed/compared collections are deferred until the whole graph is
+            // built (so cyclic keys are complete before they are hashed/compared). Run in
+            // encounter order; each action populates its own collection from now-complete objects.
+            private readonly List<Action> deferred = new();
+            public Reader(BinaryReader br) { this.br = br; }
+
+            /// <summary>Flush all deferred collection inserts (call once after reading the roots).</summary>
+            public void RunDeferred()
+            {
+                foreach (var a in deferred)
+                    a();
+                deferred.Clear();
+            }
+
+            public object? ReadValue(Type declared)
+            {
+                byte tag = br.ReadByte();
+                switch (tag)
+                {
+                case T_NULL: return null;
+                case T_REF: return ids[br.ReadInt32()];
+                case T_STRING: return br.ReadString();
+                case T_PRIM: { var t = Type.GetType(br.ReadString())!; return ReadPrim(t); }
+                case T_ENUM: { var t = Type.GetType(br.ReadString())!; var u = ReadPrim(Enum.GetUnderlyingType(t)); return Enum.ToObject(t, u!); }
+                case T_OPERATOR: return ResolveOperator((OperatorType) br.ReadInt32());
+                case T_ARRAY:
+                {
+                    int id = br.ReadInt32(); var t = Type.GetType(br.ReadString())!; var et = t.GetElementType()!;
+                    int len = br.ReadInt32(); var arr = Array.CreateInstance(et, len); ids[id] = arr;
+                    for (int i = 0; i < len; ++i) arr.SetValue(ReadValue(et), i);
+                    return arr;
+                }
+                case T_DICT:
+                {
+                    int id = br.ReadInt32(); var t = Type.GetType(br.ReadString())!;
+                    var dict = (IDictionary)RuntimeHelpers.GetUninitializedObject(t); CallCtor(dict, t); ids[id] = dict;
+                    int n = br.ReadInt32();
+                    // Read the pairs now (sequential file), but insert LATER: hash/compare-based
+                    // dictionaries (incl. SortedList with a type-graph comparer) must not touch
+                    // keys until they are fully reconstructed (cyclic keys).
+                    var pairs = new (object? k, object? v)[n];
+                    for (int i = 0; i < n; ++i) { var k = ReadValue(typeof(object)); var v = ReadValue(typeof(object)); pairs[i] = (k, v); }
+                    deferred.Add(() => { foreach (var (k, v) in pairs) dict[k!] = v; });
+                    return dict;
+                }
+                case T_LIST:
+                {
+                    int id = br.ReadInt32(); var t = Type.GetType(br.ReadString())!;
+                    var obj = RuntimeHelpers.GetUninitializedObject(t); CallCtor(obj, t); ids[id] = obj;
+                    int n = br.ReadInt32();
+                    var add = t.GetMethod("Add")!;
+                    bool isHashSet = t.IsGenericType && t.GetGenericTypeDefinition() == typeof(HashSet<>);
+                    if (isHashSet)
+                    {
+                        // HashSet hashes elements on Add -> defer (cyclic elements).
+                        var items = new object?[n];
+                        for (int i = 0; i < n; ++i) items[i] = ReadValue(typeof(object));
+                        deferred.Add(() => { foreach (var it in items) add.Invoke(obj, new[] { it }); });
+                    }
+                    else
+                    {
+                        // List preserves order and does not hash -> insert immediately.
+                        for (int i = 0; i < n; ++i) add.Invoke(obj, new[] { ReadValue(typeof(object)) });
+                    }
+                    return obj;
+                }
+                case T_OBJECT:
+                {
+                    int id = br.ReadInt32(); var t = Type.GetType(br.ReadString())!;
+                    var obj = RuntimeHelpers.GetUninitializedObject(t); ids[id] = obj;
+                    int nf = br.ReadInt32();
+                    var byName = InstanceFields(t).ToDictionary(f => f.DeclaringType!.FullName + "::" + f.Name);
+                    for (int i = 0; i < nf; ++i)
+                    {
+                        string key = br.ReadString();
+                        var val = ReadValue(typeof(object));
+                        if (byName.TryGetValue(key, out var f)) f.SetValue(obj, val);
+                    }
+                    return obj;
+                }
+                default: throw new InvalidDataException("bad tag " + tag);
+                }
+            }
+
+            private static void CallCtor(object o, Type t)
+            {
+                var c = t.GetConstructor(Type.EmptyTypes);
+                c?.Invoke(o, null);
+            }
+
+            private object? ReadPrim(Type t)
+            {
+                switch (Type.GetTypeCode(t))
+                {
+                case TypeCode.Boolean: return br.ReadBoolean();
+                case TypeCode.Byte: return br.ReadByte();
+                case TypeCode.SByte: return br.ReadSByte();
+                case TypeCode.Int16: return br.ReadInt16();
+                case TypeCode.UInt16: return br.ReadUInt16();
+                case TypeCode.Int32: return br.ReadInt32();
+                case TypeCode.UInt32: return br.ReadUInt32();
+                case TypeCode.Int64: return br.ReadInt64();
+                case TypeCode.UInt64: return br.ReadUInt64();
+                case TypeCode.Char: return br.ReadChar();
+                case TypeCode.Single: return br.ReadSingle();
+                case TypeCode.Double: return br.ReadDouble();
+                default:
+                    if (t == typeof(IntPtr)) return (IntPtr)br.ReadInt64();
+                    if (t == typeof(UIntPtr)) return (UIntPtr)br.ReadUInt64();
+                    throw new NotSupportedException("prim " + t);
+                }
+            }
+        }
+
+        // ---- Operator singleton registry (OperatorType -> the canonical Operator instance) ----
+        private static Dictionary<OperatorType, Operator>? operatorRegistry;
+
+        private static Operator ResolveOperator(OperatorType type)
+        {
+            operatorRegistry ??= BuildOperatorRegistry();
+            if (operatorRegistry.TryGetValue(type, out var op))
+                return op;
+            throw new InvalidDataException("No singleton Operator for OperatorType." + type +
+                " (add it to Operator's static fields or extend the registry).");
+        }
+
+        private static Dictionary<OperatorType, Operator> BuildOperatorRegistry()
+        {
+            var d = new Dictionary<OperatorType, Operator>();
+            foreach (var f in typeof(Operator).GetFields(BindingFlags.Public | BindingFlags.Static))
+            {
+                if (typeof(Operator).IsAssignableFrom(f.FieldType) && f.GetValue(null) is Operator op)
+                    d[op.Type] = op;
+            }
+            return d;
+        }
+
+        // ---- Fast self-test (no 30-min decode needed) ---------------------------------------
+        // Round-trips a small synthetic graph that mirrors the shapes of the real cache: the
+        // custom StructureFieldCollection, the SortedList-with-comparer union collection, a
+        // cyclic type reference, operator singletons, a structured procedure Body, and the
+        // arch/Frame/Block cutoffs. Invoked from Decompiler.ScanPrograms when REKO_CACHE_SELFTEST
+        // is set, using the real (loaded) architecture. Returns a report; throws on failure.
+        /// <summary>[PR2] Round-trips a synthetic graph to validate the serializer in seconds
+        /// (no full decode). Returns a PASS/FAIL report; throws <see cref="InvalidOperationException"/>
+        /// on any failure.</summary>
+        /// <param name="arch">A live architecture used to build the synthetic procedure.</param>
+        /// <returns>A human-readable PASS/FAIL report.</returns>
+        public static string SelfTest(IProcessorArchitecture arch)
+        {
+            var sb = new StringBuilder();
+            int failures = 0;
+            void Check(bool ok, string what)
+            {
+                sb.AppendLine((ok ? "  PASS " : "  FAIL ") + what);
+                if (!ok) ++failures;
+            }
+
+            var w32 = PrimitiveType.Word32;
+
+            // 1) Type graph: struct (custom collection) + self-cycle, union, typeref, eqclass.
+            var str = new StructureType("MyStruct", 8);
+            str.Fields.Add(0, w32, "f0");
+            str.Fields.Add(4, new Reko.Core.Types.Pointer(str, 32), "next");          // self-cycle
+            var uni = new UnionType("MyUnion", null, w32, PrimitiveType.Real64);
+            var tref = new TypeReference("MyRef", str);
+            var eq = new EquivalenceClass(new TypeVariable("t1", 1), str);
+            // Cyclic union (the shape that broke load): >=2 alternatives that are pointers to
+            // structs which contain this very union, so inserting the SortedList keys on load
+            // compares them and walks the cycle -- which throws unless inserts are deferred
+            // until the graph is complete.
+            var scA = new StructureType("CycA", 8);
+            var scB = new StructureType("CycB", 12);
+            var uniCyc = new UnionType("CycUnion", null);
+            uniCyc.Alternatives.Add(new Reko.Core.Types.Pointer(scA, 32));
+            uniCyc.Alternatives.Add(new Reko.Core.Types.Pointer(scB, 32));
+            scA.Fields.Add(0, uniCyc, "u");          // cyclic, distinct layout from scB
+            scB.Fields.Add(0, uniCyc, "u");
+            scB.Fields.Add(4, w32, "x");             // extra field -> scB != scA under the comparer
+            var types = new List<object> { str, uni, tref, eq, uniCyc };
+
+            // 2) A structured procedure with a Body using an operator singleton.
+            var frame = arch.CreateFrame();
+            var addr = Address.Ptr32(0x00401000);
+            var proc = new Procedure(arch, "fnSelfTest", addr, frame);
+            var ia = Identifier.CreateTemporary("a", w32);
+            var ib = Identifier.CreateTemporary("b", w32);
+            proc.Body = new List<AbsynStatement>
+            {
+                new AbsynAssignment(ia, new BinaryExpression(Operator.IAdd, w32, ia, ib)),
+                new AbsynReturn(ia),
+            };
+            var procs = new List<object> { proc };
+
+            // 3) Cutoffs: arch / frame / block must all serialize to null.
+            var block = new Block(proc, addr, "fnSelfTest_blk");
+            var cutoffs = new List<object> { arch, frame, block };
+
+            var tmp = Path.Combine(Path.GetTempPath(), "reko_ptc_selftest.bin");
+            Save(new List<object> { types, procs, cutoffs }, tmp);
+            var roots = Load(tmp);
+            try { File.Delete(tmp); } catch { }
+
+            Check(roots.Count == 3, "root count == 3");
+
+            var t2 = (IList)roots[0]!;
+            var s2 = (StructureType)t2[0]!;
+            Check(s2.Fields.Count == 2, "struct field count == 2");
+            Check(s2.Fields[0].Name == "f0" && s2.Fields[0].Offset == 0, "struct field[0] f0@0");
+            Check(s2.Fields[1].Name == "next", "struct field[1] name");
+            Check(ReferenceEquals(((Reko.Core.Types.Pointer)s2.Fields[1].DataType).Pointee, s2), "self-cycle preserved (same instance)");
+            var u2 = (UnionType)t2[1]!;
+            Check(u2.Alternatives.Count == 2, "union alternatives == 2");
+            var tr2 = (TypeReference)t2[2]!;
+            Check(ReferenceEquals(tr2.Referent, s2), "typeref shares the struct instance");
+            var eq2 = (EquivalenceClass)t2[3]!;
+            Check(eq2 is not null, "equivalence class round-trips");
+            var uc2 = (UnionType)t2[4]!;
+            Check(uc2.Alternatives.Count == 2, "cyclic union alternatives == 2 (deferred sorted insert)");
+
+            var p2 = (Procedure)((IList)roots[1]!)[0]!;
+            Check(p2.Architecture is null, "procedure architecture cut to null");
+            Check(p2.Body is not null && p2.Body.Count == 2, "body statement count == 2");
+            var asg = (AbsynAssignment)p2.Body![0];
+            var be = (BinaryExpression)asg.Src;
+            Check(ReferenceEquals(be.Operator, Operator.IAdd), "operator resolved to singleton Operator.IAdd");
+            Check(((Identifier)be.Left).Name == "a", "identifier name preserved");
+
+            var cut = (IList)roots[2]!;
+            Check(cut[0] is null, "arch cut to null");
+            Check(cut[1] is null, "frame cut to null");
+            Check(cut[2] is null, "block cut to null");
+
+            sb.Insert(0, failures == 0
+                ? "[CACHE SELFTEST] ALL PASS\n"
+                : $"[CACHE SELFTEST] {failures} FAILURE(S)\n");
+            if (failures != 0)
+                throw new InvalidOperationException(sb.ToString());
+            return sb.ToString();
+        }
+    }
+}
