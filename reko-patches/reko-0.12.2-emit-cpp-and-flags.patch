+    /// are constructed in many call sites across the codebase.
+    /// </summary>
+    public static class Pr2Options
+    {
+        /// <summary>
+        /// True when <c>REKO_EMIT_CPP=1</c>: emit readable, idiomatic C++ (native
+        /// <c>base.field</c> / <c>ptr-&gt;field</c> member access, natural constructor-call
+        /// names) instead of the "correct but ugly" byte-offset-reinterpret C rendering.
+        /// PR2.exe is a C++ binary, so this reads like its original source.
+        /// </summary>
+        public static readonly bool Cpp =
+            !string.IsNullOrEmpty(System.Environment.GetEnvironmentVariable("REKO_EMIT_CPP"));
+    }
+}
